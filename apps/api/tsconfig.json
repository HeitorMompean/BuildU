{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "declaration": false,
    "sourceMap": true,
    "noEmit": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@hs/backend": [
        "../../packages/backend/src/index.ts"
      ],
      "@hs/domain": [
        "../../packages/domain/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts"
  ]
}